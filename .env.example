# .env.example
# Copiar como ".env" y completar con tus valores reales.
# El archivo ".env" NUNCA se sube al repositorio.

DATABASE_URL=postgresql://postgres:secretpassword@localhost:5432/futbot_db
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development

POSTGRES_USER=postgres
POSTGRES_PASSWORD=secretpassword
POSTGRES_DB=futbot_db

SECRET_KEY=todos-en-el-grupo-usamos-la-misma-secret-key  

ACCESS_TOKEN_EXPIRE_MINUTES=120

# Dirección base de los WebSockets (sin barra final).
WS_BASE_URL=ws://localhost:8000